# ---- 의존성 / 빌드 결과물 ----
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.vite/

# ---- 환경 변수 (API 주소·키 등) ----
# .env.example 만 커밋하고 실제 값이 들어간 파일은 모두 제외
.env
.env.*
!.env.example
*.local

# ---- 인증서 / 키 ----
*.pem
*.key
*.crt
*.p12
*.pfx

# ---- 로그 ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- 개인 에디터 / 도구 설정 ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
.claude/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 설계 원본 문서 (팀 공유 드라이브에서 관리) ----
*.docx
*.hwp
*.pptx
